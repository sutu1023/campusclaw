# Copy this file to `.env` before running `docker compose up`.
# Never commit real secrets. Values shown after `=` are placeholders.

# --- Required ---------------------------------------------------------------
# Pepper used to hash session tokens (HMAC-SHA256). The app refuses to start
# when unset. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=

# MySQL DSN used by the Go API and the migration/backfill commands.
DB_DSN=campusclaw:campusclaw@tcp(db:3306)/campusclaw?parseTime=true

# MySQL container bootstrap (only used by the db service).
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=campusclaw

# --- Optional ---------------------------------------------------------------
# Token lifetime (Go duration) and upload limits.
SESSION_TTL=24h
MAX_UPLOAD_BYTES=16777216
UPLOAD_DIR=/app/uploads

# Qdrant.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=campusclaw_chunks

# External embedding gateway (OpenAI-compatible /embeddings).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# External chat gateway (OpenAI-compatible /chat/completions).
# Leave CHAT_BASE_URL / CHAT_API_KEY empty to reuse the embedding gateway above
# (same API); CHAT_MODEL picks the chat model on that gateway.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=course-chat

# MCP: secret stays only in the local .env and server processes, never VITE_*.
# Required by mcp-demo when it is started; optional for the main API.
MCP_AUTH_TOKEN=
# Deployment allowlist (non-secret JSON). Approve exact class/name/origin only.
# Each additional target requires its own MCP_*_TOKEN environment variable.
# Empty allowlist disables MCP registration/credential access, not API startup.
MCP_CREDENTIAL_BINDINGS='[{"class_id":1,"server_name":"campus-tools","base_url":"http://mcp-demo:8090","token_env":"MCP_AUTH_TOKEN"}]'
MCP_MAX_ROUNDS=3
MCP_MAX_CALLS_PER_TURN=8
MCP_MAX_CALLS_PER_CONVERSATION=40
MCP_TURN_TIMEOUT=20s
MCP_REQUEST_TIMEOUT=5s

# Retrieval parameters.
VECTOR_MIN_SCORE=0.35
RRF_K=60
