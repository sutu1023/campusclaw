# Copy this file to `.env` before running `docker compose up`.
#
# SECRET_KEY signs the session cookie and is REQUIRED. The application refuses
# to start when it is missing, so there is no insecure fallback.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional overrides (defaults shown, normally leave unset in Compose):
# DATABASE_PATH=/app/data/app.db
# UPLOAD_DIR=/app/uploads
# GUNICORN_WORKERS=2
